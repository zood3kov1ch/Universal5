local function stopSpectate()
	SpectateTarget = nil
	if Humanoid then Camera.CameraSubject = Humanoid end
end

local function spectate(player)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		SpectateTarget = player
		Camera.CameraSubject = hum
		notify("Viewing " .. player.DisplayName)
	else
		notify("Player has no character")
	end
end

local function cycleSpectate(dir)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(list, p) end
	end
	if #list == 0 then return end
	local idx = table.find(list, SpectateTarget) or 0
	idx = (idx - 1 + dir) % #list + 1
	spectate(list[idx])
end

local function followPlayer(player)
	FollowTarget = player
	notify("Following " .. player.DisplayName)
end

