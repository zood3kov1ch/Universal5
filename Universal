			part.Anchored = true
			part.Size = Vector3.new(8, 1, 8)
			part.Transparency = 1
			part.CanQuery = false
			part.Parent = workspace
			RT.air = part
		end

		local legOffset = Humanoid.RigType == Enum.HumanoidRigType.R6 and 3 or (Humanoid.HipHeight + Root.Size.Y / 2)
		local feetY = Root.Position.Y - legOffset
		if not RT.airY then RT.airY = feetY - 0.1 end

		if not typing() and UserInputService:IsKeyDown(Enum.KeyCode.Space) and feetY > RT.airY + 1.5 then
			RT.airY = feetY - 0.1
		end
		if not typing() and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			RT.airY = RT.airY - 20 * dt
		end

		RT.air.CFrame = CFrame.new(Root.Position.X, RT.airY - 0.5, Root.Position.Z)
	elseif RT.air then
		RT.air:Destroy()
		RT.air = nil
		RT.airY = nil
	end
