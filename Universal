local function aimKeyDown()
	local mode = Settings.AimKey
	if mode == "Right Mouse" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
	if mode == "Left Mouse" then return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
	if mode == "Hold E" then return UserInputService:IsKeyDown(Enum.KeyCode.E) end
	return true
end

local function getAimPart(character)
	local name = Settings.AimPart
	if name == "Torso" then
		return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
	end
	return character:FindFirstChild(name) or character:FindFirstChild("HumanoidRootPart")
end

local function hasLineOfSight(part)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { Character, part.Parent }
	params.IgnoreWater = true
	local origin = Camera.CFrame.Position
	return workspace:Raycast(origin, part.Position - origin, params) == nil
end

local function getAimTarget()
	local mouse = UserInputService:GetMouseLocation()
	local origin = Camera.CFrame.Position
	local best, bestDist = nil, Settings.AimFOV

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			local part = getAimPart(player.Character)
			if hum and part and hum.Health > 0 then
				local sameTeam = Settings.AimTeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team
				if not sameTeam and (part.Position - origin).Magnitude <= Settings.AimDistance then
					local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
					if onScreen then
						local d = (Vector2.new(screen.X, screen.Y) - mouse).Magnitude
						if d < bestDist and (not Settings.AimWallCheck or hasLineOfSight(part)) then
							best, bestDist = part, d
						end
					end
				end
			end
		end
	end
	return best
end

local function updateAim(dt)
	if freecam.Active then return end
	if not (Settings.AimAssist and aimKeyDown()) then return end
	local part = getAimTarget()
	if not part then return end

	local aimPos = part.Position + part.AssemblyLinearVelocity * (Settings.AimPrediction / 100)
	local goal = CFrame.lookAt(Camera.CFrame.Position, aimPos)
	local s = math.clamp(Settings.AimSmooth / 100, 0.01, 1)
	local alpha = s >= 1 and 1 or 1 - (1 - s) ^ (dt * 60)
	Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
end

