local function updateFeatures(dt)
	RT.hue = (RT.hue + dt * 0.25) % 1
	fpsAverage = fpsAverage * 0.9 + (1 / math.max(dt, 0.001)) * 0.1

	RT.slow = RT.slow + dt
	local slow = false
	if RT.slow >= 0.25 then
		RT.slow = 0
		slow = true
	end

	-- FOV circle
	if Settings.FOVCircle then
		local m = UserInputService:GetMouseLocation()
		FOVCircle.Visible = true
		FOVCircle.Size = UDim2.fromOffset(Settings.AimFOV * 2, Settings.AimFOV * 2)
		FOVCircle.Position = UDim2.fromOffset(m.X, m.Y)
		FOVStroke.Color = accentColor()
	else
		FOVCircle.Visible = false
	end

	-- Rainbow accent / ambient / fullbright / day cycle
	if Settings.RainbowAccent then
		RT.accent = RT.accent + dt
		if RT.accent > 0.08 then
			RT.accent = 0
			Accents.Rainbow = Color3.fromHSV(RT.hue, 0.5, 1)
			applyTheme()
		end
	end
	if Settings.RainbowAmbient then
		Lighting.Ambient = Color3.fromHSV(RT.hue, 0.6, 1)
	elseif Settings.Fullbright then
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
	end
	if Settings.DayCycle then
		Lighting.ClockTime = (Lighting.ClockTime + dt * Settings.CycleSpeed * 0.05) % 24
	end

	updateFreecam(dt)
	updateAirWalk(dt)

	-- Spectate safety
	if SpectateTarget then
		local hum = SpectateTarget.Character and SpectateTarget.Character:FindFirstChildOfClass("Humanoid")
		if not SpectateTarget.Parent then
			stopSpectate()
		elseif hum and Camera.CameraSubject ~= hum then
			Camera.CameraSubject = hum
		end
	end

	-- Character-based features
	if Humanoid and Root and Humanoid.Health > 0 then
		local focused = typing()
		local vel = Root.AssemblyLinearVelocity

		if Settings.BunnyHop and not focused and UserInputService:IsKeyDown(Enum.KeyCode.Space) and Humanoid.FloorMaterial ~= Enum.Material.Air then
			Humanoid.Jump = true
		end
		if Settings.SpinBot then
			Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
		end
		if Settings.SafeFall and vel.Y < -80 then
			Root.AssemblyLinearVelocity = Vector3.new(vel.X, -40, vel.Z)
		end
		if Settings.FastFall and not focused and UserInputService:IsKeyDown(Settings.Keys.FastFall) and Humanoid.FloorMaterial == Enum.Material.Air then
			Root.AssemblyLinearVelocity = Vector3.new(vel.X, -120, vel.Z)
		end
		if Settings.AutoWalk then Humanoid:Move(Vector3.new(0, 0, -1), true) end
		if Settings.PlatformStand then Humanoid.PlatformStand = true end
		if Settings.Freeze and not Root.Anchored then Root.Anchored = true end
		if Settings.Ragdoll and slow then Humanoid:ChangeState(Enum.HumanoidStateType.Physics) end

		if Settings.HideSelf and Character then
			for _, part in ipairs(Character:GetDescendants()) do
				if part:IsA("BasePart") then part.LocalTransparencyModifier = 1 end
			end
		end

		-- Anti Void
		if Settings.AntiVoid then
			if slow and Humanoid.FloorMaterial ~= Enum.Material.Air then RT.safe = Root.CFrame end
			if RT.safe and Root.Position.Y < workspace.FallenPartsDestroyHeight + 60 then
				Root.AssemblyLinearVelocity = Vector3.zero
				Root.CFrame = RT.safe + Vector3.new(0, 3, 0)
				notify("Anti Void: rescued", 2)
			end
		end

		-- Follow player
		if FollowTarget then
			local tr = FollowTarget.Character and FollowTarget.Character:FindFirstChild("HumanoidRootPart")
			if tr then
				Root.CFrame = tr.CFrame * CFrame.new(0, 0, Settings.FollowDistance)
				Root.AssemblyLinearVelocity = Vector3.zero
			end
		end

		-- Survival
		if Settings.GodMode and Humanoid.Health < Humanoid.MaxHealth then
			Humanoid.Health = Humanoid.MaxHealth
		end

		-- Auto activate tool
		if Settings.AutoTool then
			RT.tool = RT.tool + dt
			if RT.tool >= Settings.ToolDelay / 1000 then
				RT.tool = 0
				local tool = Character and Character:FindFirstChildOfClass("Tool")
				if tool then tool:Activate() end
			end
		end

		-- Animation speed
		local animActive = Settings.AnimSpeed ~= 100
		if animActive or RT.animWas then
			local animator = Humanoid:FindFirstChildOfClass("Animator")
			if animator then
				local speed = animActive and (Settings.AnimSpeed / 100) or 1
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:AdjustSpeed(speed) end
			end
			RT.animWas = animActive
		end

		-- Slow (4x/sec) tasks
		if slow then
			if Settings.AutoHeal then
				Humanoid.Health = math.min(Humanoid.MaxHealth, Humanoid.Health + Settings.HealRate * 0.25)
			end

			if Settings.AutoEquip and Character and not Character:FindFirstChildOfClass("Tool") then
				equipNextTool()
			end

			if Character then
				if Settings.SelfHighlight then
					local h = Character:FindFirstChild("FemboySoftSelf")
					if not h then
						h = Instance.new("Highlight")
						h.Name = "FemboySoftSelf"
						h.FillTransparency = 0.7
						h.Parent = Character
					end
					h.FillColor = accentColor()
					h.OutlineColor = accentColor()
				end

				if Settings.LocalFF and not Character:FindFirstChild("FemboySoftFF") then
					local ff = Instance.new("ForceField")
					ff.Name = "FemboySoftFF"
					ff.Parent = Character
				end
			end

			if Settings.InfiniteStamina then
				for _, holder in ipairs({ Character, LocalPlayer }) do
					if holder then
						for name, value in pairs(holder:GetAttributes()) do
							if type(value) == "number" and string.find(string.lower(name), "stamina") then
								local key = holder.Name .. name
								StaminaMax[key] = math.max(StaminaMax[key] or 0, value)
								holder:SetAttribute(name, StaminaMax[key])
							end
						end
						for _, child in ipairs(holder:GetChildren()) do
							if (child:IsA("NumberValue") or child:IsA("IntValue")) and string.find(string.lower(child.Name), "stamina") then
								local key = holder.Name .. child.Name
								StaminaMax[key] = math.max(StaminaMax[key] or 0, child.Value)
								child.Value = StaminaMax[key]
							end
						end
					end
				end
			end
		end
	end

	if slow then
		updateHud()
		updateCrosshair()
	end

	RT.info = RT.info + dt
	if RT.info >= 0.5 then
		RT.info = 0
		updateInfoLabels()
	end
end

