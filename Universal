-- opts: { decimals = 0, suffix = "", silent = false, noReset = false }
local function createSlider(parent, text, min, max, default, callback, opts)
	opts = opts or {}
	local mult = 10 ^ (opts.decimals or 0)
	local suffix = opts.suffix or ""

	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.new(1, -8, 0, 60)
	Frame.BorderSizePixel = 0
	Frame.Parent = parent
	table.insert(ThemeRegistry.Elements, Frame)

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 8)
	Corner.Parent = Frame

	local Stroke = Instance.new("UIStroke")
	Stroke.Thickness = 1
	Stroke.Parent = Frame
	table.insert(ThemeRegistry.Strokes, Stroke)

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(0.7, 0, 0, 25)
	Label.Position = UDim2.fromOffset(14, 5)
	Label.BackgroundTransparency = 1
	Label.Text = text
	Label.Font = Enum.Font.GothamMedium
	Label.TextSize = 13
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Frame
	table.insert(ThemeRegistry.TextPrimary, Label)

	local ValueLabel = Instance.new("TextLabel")
	ValueLabel.Size = UDim2.new(0.3, -14, 0, 25)
	ValueLabel.Position = UDim2.new(0.7, 0, 0, 5)
	ValueLabel.BackgroundTransparency = 1
	ValueLabel.Font = Enum.Font.Gotham
	ValueLabel.TextSize = 12
	ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
	ValueLabel.Parent = Frame
	table.insert(ThemeRegistry.TextSecondary, ValueLabel)

	local Bar = Instance.new("Frame")
	Bar.Size = UDim2.new(1, -28, 0, 4)
	Bar.Position = UDim2.fromOffset(14, 38)
	Bar.BackgroundColor3 = Color3.fromRGB(150, 150, 160)
	Bar.BackgroundTransparency = 0.6
	Bar.BorderSizePixel = 0
	Bar.Parent = Frame

	local BC = Instance.new("UICorner")
	BC.CornerRadius = UDim.new(1, 0)
	BC.Parent = Bar

	local Fill = Instance.new("Frame")
	Fill.Name = "Fill"
	Fill.Size = UDim2.fromScale((default - min) / (max - min), 1)
	Fill.BorderSizePixel = 0
	Fill.Parent = Bar
	table.insert(ThemeRegistry.Accents, Fill)

	local FC = Instance.new("UICorner")
	FC.CornerRadius = UDim.new(1, 0)
	FC.Parent = Fill

	local dragging = false

	local function setValue(value, silent)
		value = math.clamp(value, min, max)
		value = math.floor(value * mult + 0.5) / mult
		local percent = (value - min) / (max - min)
		Fill.Size = UDim2.fromScale(percent, 1)
		ValueLabel.Text = tostring(value) .. suffix
		if not silent then callback(value) end
	end

	local function fromMouse(x)
		local percent = math.clamp((x - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
		setValue(min + (max - min) * percent)
	end

	-- Клік по нижній половині блоку теж рухає слайдер (зручніше, ніж цілитись у 4px смужку)
	Frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if input.Position.Y - Frame.AbsolutePosition.Y > 28 then
				dragging = true
				fromMouse(input.Position.X)
			end
		end
	end)

	connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)

	connect(UserInputService.InputChanged, function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			fromMouse(input.Position.X)
		end
	end)

	Sliders[text] = function(v) setValue(v) end
	SliderDefaults[text] = default
	if opts.noReset then SliderNoReset[text] = true end

	setValue(default, opts.silent)
	return Frame
end

-- defs = { {"Text", function(button) ... end}, ... }
local function createRow(parent, defs, height)
	local Row = Instance.new("Frame")
	Row.Size = UDim2.new(1, -8, 0, height or 36)
	Row.BackgroundTransparency = 1
	Row.BorderSizePixel = 0
	Row.Parent = parent

	local Layout = Instance.new("UIListLayout")
	Layout.FillDirection = Enum.FillDirection.Horizontal
	Layout.Padding = UDim.new(0, 6)
	Layout.Parent = Row

	local count = #defs
	local buttons = {}

	for i, def in ipairs(defs) do
		local B = Instance.new("TextButton")
		B.Size = UDim2.new(1 / count, -6 * (count - 1) / count, 1, 0)
		B.BorderSizePixel = 0
		B.AutoButtonColor = false
		B.Text = def[1]
		B.Font = Enum.Font.GothamMedium
		B.TextSize = count > 2 and 11 or 12
		B.TextTruncate = Enum.TextTruncate.AtEnd
		B.Parent = Row
		decorate(B)
		table.insert(ThemeRegistry.TextPrimary, B)
		hover(B)
		B.MouseButton1Click:Connect(function() def[2](B) end)
		buttons[i] = B
	end

	return Row, buttons
end

local function createButton(parent, text, callback)
	local _, buttons = createRow(parent, { { text, callback } }, 38)
	return buttons[1]
end

local function createCycle(parent, text, options, default, callback)
	local index = table.find(options, default) or 1

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -8, 0, 38)
	Button.BorderSizePixel = 0
	Button.AutoButtonColor = false
	Button.Font = Enum.Font.GothamMedium
	Button.TextSize = 13
	Button.Parent = parent
	decorate(Button)
	table.insert(ThemeRegistry.TextPrimary, Button)
	hover(Button)

	local function refresh()
		Button.Text = text .. ": " .. options[index]
	end

	Button.MouseButton1Click:Connect(function()
		index = index % #options + 1
		refresh()
		callback(options[index], index)
	end)

	refresh()
	callback(options[index], index)
	return Button
end

