local function updateCrosshair()
	CrosshairFolder.Visible = Settings.Crosshair
	if not Settings.Crosshair then return end
	local len, gap = Settings.CrosshairSize, Settings.CrosshairGap
	local color = CrosshairColors[Settings.CrosshairColor] or Accents[Settings.AccentName] or Accents.Pink
	local off = gap + len / 2
	local top, bottom, left, right, dot = CrosshairParts[1], CrosshairParts[2], CrosshairParts[3], CrosshairParts[4], CrosshairParts[5]

	top.Size = UDim2.fromOffset(2, len)
	top.Position = UDim2.new(0.5, 0, 0.5, -off)
	bottom.Size = UDim2.fromOffset(2, len)
	bottom.Position = UDim2.new(0.5, 0, 0.5, off)
	left.Size = UDim2.fromOffset(len, 2)
	left.Position = UDim2.new(0.5, -off, 0.5, 0)
	right.Size = UDim2.fromOffset(len, 2)
	right.Position = UDim2.new(0.5, off, 0.5, 0)
	dot.Size = UDim2.fromOffset(3, 3)
	dot.Position = UDim2.fromScale(0.5, 0.5)

