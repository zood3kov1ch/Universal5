local function hookCharacter(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	hum.Died:Connect(function()
		local r = char:FindFirstChild("HumanoidRootPart")
		if r then DeathCFrame = r.CFrame end
	end)
end

if LocalPlayer.Character then task.spawn(hookCharacter, LocalPlayer.Character) end

connect(LocalPlayer.CharacterAdded, function(char)
	task.spawn(hookCharacter, char)
	local target = PendingRespawn or (Settings.SpawnAtDeath and DeathCFrame) or nil
	PendingRespawn = nil
	if target then
		local r = char:WaitForChild("HumanoidRootPart", 5)
		task.wait(0.7)
		if r and r.Parent then r.CFrame = target end
	end
end)

connect(UserInputService.JumpRequest, function()
	if Settings.InfJump and Humanoid then
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

connect(LocalPlayer.Idled, function()
	if Settings.AntiAFK then
		pcall(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end)
	end
end)

connect(Players.PlayerRemoving, function(player)
	removeVisuals(player)
	removeESP(player)
	if FollowTarget == player then FollowTarget = nil end
end)

--==================================================
-- UNLOAD
--==================================================

unload = function()
	disableAll()
	Unloaded = true

	updateFreecam(0)
	stopFly()

	for _, player in ipairs(Players:GetPlayers()) do
		removeVisuals(player)
		removeESP(player)
	end

	for _, className in ipairs(EffectNames) do
		local effect = Lighting:FindFirstChild("FemboySoft_" .. className)
		if effect then effect:Destroy() end
	end

	if RT.air then RT.air:Destroy() RT.air = nil end
	if Character then
		for _, name in ipairs({ "FemboySoftSelf", "FemboySoftFF" }) do
			local obj = Character:FindFirstChild(name)
			if obj then obj:Destroy() end
		end
	end

	if Humanoid then
		Humanoid.WalkSpeed = 16
		Humanoid.JumpPower = 50
	end
	Camera.FieldOfView = 70
	UserInputService.MouseIconEnabled = true

	for _, c in ipairs(Connections) do c:Disconnect() end
	Overlay:Destroy()
	Gui:Destroy()
end

