local function snapshotToggle(store, enabled, classList, property, offValue, filter)
	if enabled then
		for _, inst in ipairs(workspace:GetDescendants()) do
			for _, className in ipairs(classList) do
				if inst:IsA(className) and not inst:IsA("Terrain") and (not filter or filter(inst)) then
					if store[inst] == nil then store[inst] = inst[property] end
					inst[property] = offValue
					break
				end
			end
		end
	else
		for inst, original in pairs(store) do
			if inst.Parent then inst[property] = original end
			store[inst] = nil
		end
	end
end

