--==================================================
-- TELEPORT FUNCTIONS
--==================================================

local function teleportToCFrame(cf, skipUndo)
	if not Root then return end
	if not skipUndo then LastCFrame = Root.CFrame end
	if Settings.SmoothTP then
		TweenService:Create(Root, TweenInfo.new(Settings.TweenTime, Enum.EasingStyle.Quad), { CFrame = cf }):Play()
	else
		Root.CFrame = cf
		Root.AssemblyLinearVelocity = Vector3.zero
	end
end

local function tpOffset(vec)
	if Root then teleportToCFrame(Root.CFrame + vec) end
end

local function otherRoots()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local r = p.Character:FindFirstChild("HumanoidRootPart")
			if r then table.insert(list, { Player = p, Root = r }) end
		end
	end
	return list
end

local function tpToPlayer(player)
	local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if r then
		teleportToCFrame(r.CFrame + Vector3.new(0, 3, 0))
	else
		notify("Player has no character")
	end
end

local function tpRandomPlayer()
	local list = otherRoots()
	if #list > 0 then tpToPlayer(list[math.random(#list)].Player) else notify("No other players") end
end

local function tpNearestPlayer(furthest)
	if not Root then return end
	local best, bestDist
	for _, entry in ipairs(otherRoots()) do
		local d = (entry.Root.Position - Root.Position).Magnitude
		if not bestDist or (furthest and d > bestDist) or (not furthest and d < bestDist) then
			best, bestDist = entry.Player, d
		end
	end
	if best then tpToPlayer(best) else notify("No other players") end
end

local function tpToCoords(text)
	local nums = {}
	for n in string.gmatch(text, "-?%d+%.?%d*") do table.insert(nums, tonumber(n)) end
	if #nums >= 3 then
		teleportToCFrame(CFrame.new(nums[1], nums[2], nums[3]))
		notify("Teleported to coordinates")
	else
		notify("Use format: x, y, z", 3, true)
	end
end

local function savePosition(slot)
	if Root then
		SavedSlots[slot] = Root.CFrame
		notify("Saved position in slot " .. slot)
	end
end

local function loadPosition(slot)
	if SavedSlots[slot] then teleportToCFrame(SavedSlots[slot]) else notify("Slot " .. slot .. " is empty") end
end

local function undoTeleport()
	if LastCFrame and Root then
		local current = Root.CFrame
		Root.CFrame = LastCFrame
		LastCFrame = current
	else
		notify("Nothing to undo")
	end
end

local function addWaypoint(name)
	if not Root then return end
	if name == nil or name == "" then name = "Point " .. (#Waypoints + 1) end
	table.insert(Waypoints, { Name = name, CFrame = Root.CFrame })
	if rebuildWaypoints then rebuildWaypoints() end
	notify("Waypoint added: " .. name)
end

