local function updateExtraESP()
	local origin = Camera.CFrame.Position
	local viewport = Camera.ViewportSize

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			local visible, dist = false, 0

			if hum and hrp and hum.Health > 0 then
				dist = (hrp.Position - origin).Magnitude
				visible = dist <= Settings.ESPDistance
				if visible and Settings.ESPTeamCheck and player.Team ~= nil and player.Team == LocalPlayer.Team then
					visible = false
				end
			end

			local color = visible and espColorFor(player, hum) or nil

			-- Highlight (з оригінального ESP)
			local highlight = ESPObjects[player]
			if highlight and highlight.Parent then
				highlight.Enabled = visible
				if visible then
					highlight.FillColor = color
					highlight.OutlineColor = color
					highlight.FillTransparency = Settings.ESPFill / 100
					highlight.OutlineTransparency = Settings.ESPOutline / 100
				end
			end

			-- Name tag
			local tag = TagObjects[player]
			if visible and Settings.NameESP then
				local d = getTag(player, character, character:FindFirstChild("Head") or hrp)
				local text = player.DisplayName
				local info = {}
				if Settings.ShowDistance then table.insert(info, math.floor(dist) .. "m") end
				if Settings.ShowHealth then table.insert(info, math.floor(hum.Health) .. " HP") end
				if #info > 0 then text = text .. "\n" .. table.concat(info, "  |  ") end
				d.Label.Text = text
				d.Label.TextColor3 = color
				d.Gui.Enabled = true
			elseif tag then
				tag.Gui.Enabled = false
			end

			-- Box
			local box = BoxObjects[player]
			if visible and Settings.BoxESP then
				local d = getBox(player, character)
				d.Inst.Color3 = color
				d.Inst.Visible = true
			elseif box then
				box.Inst.Visible = false
			end

			-- Tracer
			local line = TracerLines[player]
			if visible and Settings.Tracers then
				local screen, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				if onScreen then
					line = line or getTracer(player)
					local from = Vector2.new(viewport.X / 2, viewport.Y)
					local to = Vector2.new(screen.X, screen.Y)
					local delta = to - from
					line.Size = UDim2.fromOffset(delta.Magnitude, 1.5)
					line.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
					line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					line.BackgroundColor3 = color
					line.Visible = true
				elseif line then
					line.Visible = false
				end
			elseif line then
				line.Visible = false
			end
		end
	end
end

