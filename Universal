connect(RunService.RenderStepped, function(dt)
	if Unloaded then return end

	if Settings.Fly then
		if not FlyVelocity then startFly() end
	else
		if FlyVelocity then stopFly() end
	end

	if Settings.Noclip then noclip() end
	updateESP()
	updateExtraESP()

	if Humanoid then
		Humanoid.WalkSpeed = getWalkSpeed()
		Humanoid.JumpPower = getJumpPower()
	end

	if not freecam.Active then
		Camera.FieldOfView = getFOV(dt)
	end

	updateAim(dt)
	updateFeatures(dt)
end)

local HotkeyTargets = {
	Fly = "Fly",
	Noclip = "Noclip",
	ESP = "Player ESP",
	Aim = "Aim Assist",
	InfJump = "Infinite Jump",
	Freecam = "Freecam",
	Fullbright = "Fullbright",
}

connect(UserInputService.InputBegan, function(input, processed)
	if processed or Settings.Rebinding or Unloaded then return end

	-- Ctrl + Click teleport
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if Settings.ClickTP and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and Mouse.Hit then
			teleportToCFrame(CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0)))
		end
		return
	end

	local key = input.KeyCode
	if key == Enum.KeyCode.Unknown then return end

	if key == Settings.MenuKey then
		setMenuVisible(not MenuOpen)
		return
	end

	if key == Settings.Keys.Panic then
		disableAll()
		setMenuVisible(false)
		notify("PANIC: all features disabled", 3, true)
		return
	end

	if not Settings.Hotkeys then return end

	if Settings.Dash and key == Settings.Keys.Dash then
		dash()
		return
	end

	for id, toggleName in pairs(HotkeyTargets) do
		if key == Settings.Keys[id] then
			local toggle = Toggles[toggleName]
			if toggle then
				toggle.set(not toggle.get())
				notify(toggleName .. (toggle.get() and "  ON" or "  OFF"))
			end
			return
		end
	end
end)

