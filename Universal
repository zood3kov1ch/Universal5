local function applyTheme()
	local theme = Themes[Settings.CurrentTheme]
	local accent = Accents[Settings.AccentName]

	for _, frame in ipairs(ThemeRegistry.MainFrame) do
		frame.BackgroundColor3 = theme.MainBg
		frame.BackgroundTransparency = Settings.CustomAlpha
	end

	for _, frame in ipairs(ThemeRegistry.SidebarFrame) do
		frame.BackgroundColor3 = theme.SidebarBg
		frame.BackgroundTransparency = Settings.CustomAlpha + 0.1
	end

	for _, elem in ipairs(ThemeRegistry.Elements) do
		elem.BackgroundColor3 = theme.ElementBg
		elem.BackgroundTransparency = theme.ElementBgTransparency
	end

	for _, stroke in ipairs(ThemeRegistry.Strokes) do
		stroke.Color = theme.StrokeColor
		stroke.Transparency = theme.StrokeTransparency
	end

	for _, text in ipairs(ThemeRegistry.TextPrimary) do
		text.TextColor3 = theme.TextPrimary
	end

	for _, text in ipairs(ThemeRegistry.TextSecondary) do
		text.TextColor3 = theme.TextSecondary
	end

	for _, obj in ipairs(ThemeRegistry.Accents) do
		if obj:IsA("Frame") and obj.Name == "Indicator" then
			obj.BackgroundColor3 = accent
		elseif obj:IsA("Frame") and obj.Name == "Fill" then
			obj.BackgroundColor3 = accent
		end
	end
end

